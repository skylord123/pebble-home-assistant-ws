  "actions": [
    {
      "name": "set_on",
      "description": "Turn a Home Assistant entity on or off. Lights, switches, fans and climate turn on and off; media players play and pause; covers and valves open and close (a garage door, gate or door only opens with the open action); scenes and scripts run.",
      "parameters": {
        "type": "object",
        "required": ["instanceId", "on"],
        "properties": {
          "item": { "type": "string", "enum": ["entity", "light", "switch", "cover", "media_player", "climate", "scene"] },
          "instanceId": { "type": "string", "description": "The entity_id, from any home/* source" },
          "on": { "type": "boolean" }
        }
      },
      "targets": ["home/light/on", "home/switch/on", "home/entity/on", "home/cover/open", "home/media_player/on", "home/climate/on"],
      "callerPermissions": ["Location"]
    },
    {
      "name": "toggle",
      "description": "Toggle a Home Assistant entity: on and off, open and closed, play and pause, or run a scene, script or button. A lock only locks (unlock it with unlock), and a garage door, gate or door only closes (open it with open).",
      "parameters": {
        "type": "object",
        "required": ["instanceId"],
        "properties": {
          "instanceId": { "type": "string", "description": "The entity_id, from any home/* source" }
        }
      },
      "targets": ["home/entity", "home/light", "home/switch", "home/cover", "home/lock", "home/media_player", "home/climate", "home/scene"],
      "callerPermissions": ["Location"]
    },
    {
      "name": "activate",
      "description": "Run a Home Assistant scene or script, press a button, or trigger an automation.",
      "parameters": {
        "type": "object",
        "required": ["instanceId"],
        "properties": {
          "instanceId": { "type": "string", "description": "The entity_id of a scene, script, button or automation" }
        }
      },
      "targets": ["home/scene", "home/entity"],
      "callerPermissions": ["Location"]
    },
    {
      "name": "set_brightness",
      "description": "Set a Home Assistant light's brightness. 0 turns it off.",
      "parameters": {
        "type": "object",
        "required": ["instanceId", "percent"],
        "properties": {
          "item": { "type": "string", "enum": ["light", "entity"] },
          "instanceId": { "type": "string" },
          "percent": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      },
      "targets": ["home/light/brightness"],
      "callerPermissions": ["Location"]
    },
    {
      "name": "set_temperature",
      "description": "Set the target temperature of a Home Assistant thermostat or water heater. A thermostat keeping a range (heat_cool) takes target_temp_low and target_temp_high instead of temperature.",
      "parameters": {
        "type": "object",
        "required": ["instanceId"],
        "properties": {
          "instanceId": { "type": "string" },
          "temperature": { "type": "number" },
          "target_temp_low": { "type": "number" },
          "target_temp_high": { "type": "number" }
        }
      },
      "targets": ["home/climate/target_temperature"],
      "callerPermissions": ["Location"]
    },
    {
      "name": "set_hvac_mode",
      "description": "Set a Home Assistant thermostat's mode, such as heat, cool, heat_cool, auto or off.",
      "parameters": {
        "type": "object",
        "required": ["instanceId", "hvac_mode"],
        "properties": {
          "instanceId": { "type": "string" },
          "hvac_mode": { "type": "string" }
        }
      },
      "targets": ["home/climate/hvac_mode"],
      "callerPermissions": ["Location"]
    },
    {
      "name": "set_position",
      "description": "Move a Home Assistant cover or valve to a position, 0 closed to 100 open. A garage door, gate or door can only be closed this way (open it with open).",
      "parameters": {
        "type": "object",
        "required": ["instanceId", "position"],
        "properties": {
          "instanceId": { "type": "string" },
          "position": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      },
      "targets": ["home/cover/position"],
      "callerPermissions": ["Location"]
    },
    {
      "name": "open",
      "description": "Open a Home Assistant cover or valve, or open (unlatch) a lock. Locks, garage doors, gates and doors only open when the wearer has allowed apps to unlock in the watch app. Locks that need a code take it in code.",
      "parameters": {
        "type": "object",
        "required": ["instanceId"],
        "properties": {
          "instanceId": { "type": "string" },
          "code": { "type": "string" }
        }
      },
      "targets": ["home/cover", "home/lock"],
      "destructive": true,
      "requiresConfirmation": true,
      "callerPermissions": ["Location", "Unlock"]
    },
    {
      "name": "close",
      "description": "Close a Home Assistant cover or valve.",
      "parameters": {
        "type": "object",
        "required": ["instanceId"],
        "properties": { "instanceId": { "type": "string" } }
      },
      "targets": ["home/cover"],
      "callerPermissions": ["Location"]
    },
    {
      "name": "stop",
      "description": "Stop a Home Assistant cover or valve that is moving.",
      "parameters": {
        "type": "object",
        "required": ["instanceId"],
        "properties": { "instanceId": { "type": "string" } }
      },
      "targets": ["home/cover"],
      "callerPermissions": ["Location"]
    },
    {
      "name": "lock",
      "description": "Lock a Home Assistant lock. Locks that need a code take it in code.",
      "parameters": {
        "type": "object",
        "required": ["instanceId"],
        "properties": {
          "instanceId": { "type": "string" },
          "code": { "type": "string" }
        }
      },
      "targets": ["home/lock/locked"],
      "callerPermissions": ["Location"]
    },
    {
      "name": "unlock",
      "description": "Unlock a Home Assistant lock, when the wearer has allowed apps to unlock in the watch app. Locks that need a code take it in code.",
      "parameters": {
        "type": "object",
        "required": ["instanceId"],
        "properties": {
          "instanceId": { "type": "string" },
          "code": { "type": "string" }
        }
      },
      "targets": ["home/lock/locked"],
      "destructive": true,
      "requiresConfirmation": true,
      "callerPermissions": ["Location", "Unlock"]
    },
    {
      "name": "alarm_arm",
      "description": "Arm a Home Assistant alarm panel. Panels that need a code take it in code.",
      "parameters": {
        "type": "object",
        "required": ["instanceId"],
        "properties": {
          "instanceId": { "type": "string" },
          "mode": { "type": "string", "enum": ["home", "away", "night", "vacation", "custom_bypass"] },
          "code": { "type": "string" }
        }
      },
      "targets": ["home/alarm/armed"],
      "callerPermissions": ["Location"]
    },
    {
      "name": "alarm_disarm",
      "description": "Disarm a Home Assistant alarm panel, when the wearer has allowed apps to unlock in the watch app. Panels that need a code take it in code.",
      "parameters": {
        "type": "object",
        "required": ["instanceId"],
        "properties": {
          "instanceId": { "type": "string" },
          "code": { "type": "string" }
        }
      },
      "targets": ["home/alarm/armed"],
      "destructive": true,
      "requiresConfirmation": true,
      "callerPermissions": ["Location", "Unlock"]
    },
    {
      "name": "set_playing",
      "description": "Play or pause a Home Assistant media player.",
      "parameters": {
        "type": "object",
        "required": ["instanceId", "playing"],
        "properties": {
          "instanceId": { "type": "string" },
          "playing": { "type": "boolean" }
        }
      },
      "targets": ["home/media_player/playing"],
      "callerPermissions": ["Location"]
    },
    {
      "name": "next_track",
      "description": "Skip to the next track on a Home Assistant media player.",
      "parameters": {
        "type": "object",
        "required": ["instanceId"],
        "properties": { "instanceId": { "type": "string" } }
      },
      "targets": ["home/media_player"],
      "callerPermissions": ["Location"]
    },
    {
      "name": "previous_track",
      "description": "Go back to the previous track on a Home Assistant media player.",
      "parameters": {
        "type": "object",
        "required": ["instanceId"],
        "properties": { "instanceId": { "type": "string" } }
      },
      "targets": ["home/media_player"],
      "callerPermissions": ["Location"]
    },
    {
      "name": "set_volume",
      "description": "Set a Home Assistant media player's volume.",
      "parameters": {
        "type": "object",
        "required": ["instanceId", "percent"],
        "properties": {
          "instanceId": { "type": "string" },
          "percent": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      },
      "targets": ["home/media_player/volume"],
      "callerPermissions": ["Location"]
    },
    {
      "name": "call_service",
      "description": "Call a service of a shared entity's own domain on that entity, with optional service data, for what the other actions do not cover (numbers, selects, vacuums, fan speeds, ...). Only services that act on the named entity are allowed, and never unlock, open a lock, disarm, or open a garage door, gate or door; those have actions of their own that ask first.",
      "parameters": {
        "type": "object",
        "required": ["instanceId", "service"],
        "properties": {
          "instanceId": { "type": "string" },
          "service": { "type": "string", "description": "A service of the entity's own domain, such as set_value or select_option" },
          "data": { "type": "object", "description": "Service data, without any target" }
        }
      },
      "targets": ["home/entity"],
      "callerPermissions": ["Location"]
    },
    {
      "name": "ask_assistant",
      "description": "Ask Home Assistant's assistant something, or tell it to do something, in plain language, and get its reply as text. The conversation continues across asks made within a few minutes. Only works when the user has allowed it in the watch app.",
      "parameters": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string" },
          "new_conversation": { "type": "boolean", "description": "Start afresh rather than continue the last conversation" },
          "speak": { "type": "boolean", "description": "For watch apps using the Home Assistant speech SDK only; leave it out otherwise. Also starts reading the reply out, and returns JSON with the reply and a cursor for speak_next instead of plain text." },
          "rate": { "type": "integer", "enum": [8000, 16000], "description": "With speak: samples a second of the audio. 8000 unless given." }
        }
      },
      "targets": [],
      "callerPermissions": ["Location", "Assistant"]
    },
    {
      "name": "send_to_agent",
      "description": "The same as ask_assistant, under the name Index looks for, so Home Assistant's assistant can be picked as where a ring gesture or a typed message goes. Sends the message to the assistant and returns its reply as text, continuing the conversation of the last few minutes.",
      "parameters": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string" },
          "chat_id": { "type": "string", "description": "Ignored: there is only the one conversation" }
        }
      },
      "targets": [],
      "callerPermissions": ["Location", "Assistant"]
    },
    {
      "name": "create_reminder",
      "description": "Add an item to one of the Home Assistant to-do lists the user shared, such as the shopping list. instanceId picks the list from reminders/list; without it the item goes on the first shared list. A due time is kept as the list allows: with its time, as a date only, or not at all, which the reply says. notify_before_ms is ignored, as Home Assistant's lists have no reminders.",
      "parameters": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "description": "The item, e.g. Buy milk" },
          "due_iso": { "type": "string", "format": "date-time", "description": "When it is due, as an ISO 8601 date and time with its offset" },
          "timezone": { "type": "string", "description": "The IANA time zone due_iso was given in; the offset in due_iso is what counts" },
          "notify_before_ms": { "type": "integer", "minimum": 0, "description": "Ignored" },
          "instanceId": { "type": "string", "description": "The to-do list's entity_id, from reminders/list" }
        }
      },
      "targets": ["reminders/list"],
      "callerPermissions": ["Location"]
    },
    {
      "name": "speak",
      "description": "For watch apps using the Home Assistant speech SDK. Returns encoded audio, not words: never call it to answer or talk to the user; use ask_assistant. Makes speech of the text in the voice of the user's Home Assistant assistant, and returns JSON with the first slice of it as IMA ADPCM and a cursor for speak_next.",
      "parameters": {
        "type": "object",
        "required": ["text", "format"],
        "properties": {
          "text": { "type": "string", "maxLength": 20000, "description": "What to say. Markdown is read as plain words." },
          "format": { "type": "string", "enum": ["ima_adpcm"], "description": "The audio format. Only ima_adpcm, 4-bit mono." },
          "rate": { "type": "integer", "enum": [8000, 16000], "description": "Samples a second. 8000 unless given." }
        }
      },
      "targets": [],
      "callerPermissions": ["Location"]
    },
    {
      "name": "speak_next",
      "description": "For watch apps using the Home Assistant speech SDK. Returns encoded audio, not words: never call it to answer or talk to the user; use ask_assistant. Returns the slice of speech that the cursor from speak or speak_next names, as JSON.",
      "parameters": {
        "type": "object",
        "required": ["text", "next", "format"],
        "properties": {
          "text": { "type": "string", "maxLength": 20000, "description": "The same text the cursor came from" },
          "next": { "type": "string", "description": "The cursor from the last result" },
          "format": { "type": "string", "enum": ["ima_adpcm"] }
        }
      },
      "targets": [],
      "callerPermissions": ["Location"]
    }
  ]
}
