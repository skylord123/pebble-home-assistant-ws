{
  "description": "Home Assistant entities and calendars shared from the Home Assistant WS watch app, values the wearer defines with Home Assistant templates, and Home Assistant weather. Read their state and upcoming events, control them, and add items to shared to-do lists. Only what is chosen in the watch app is served; weather is always shared.",
  "script": "plugin.js",
  "definesPermissions": [
    { "name": "Unlock", "label": "Unlock doors, open gates and disarm alarms in Home Assistant", "kind": "dangerous" },
    { "name": "Assistant", "label": "Ask Home Assistant's assistant to do anything it can, unlocking included", "kind": "dangerous" }
  ],
  "sources": [
    {
      "category": "home",
      "items": ["entity"],
      "properties": {
        "name": ["shortText", "longText"],
        "room": ["shortText"],
        "state": ["shortText", "longText", "numericValue", "timestamp"],
        "history": ["series.numericValue"],
        "on": ["boolean"],
        "domain": ["shortText"],
        "last_changed": ["timestamp"],
        "last_updated": ["timestamp"],
        "supported_features": ["numericValue"]
      },
      "supportsMultiple": true,
      "suggestedRefreshIntervalSec": 30,
